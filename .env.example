# =============================================================================
# .env.example — modelo de variáveis de ambiente do sentimento-ptbr-llm.
#
# Copie para `.env` (nunca commitado — ver .gitignore) e preencha os valores
# reais. Nenhum segredo deve ser lido de configs/*.yaml (ver CLAUDE.md,
# "Data Privacy & LGPD"). Todas as variáveis usam o prefixo `SENTIMENTO_`
# (ver src/config/settings.py::Settings, src/config/constants.py).
# =============================================================================

# Ambiente de execução: development | test | production
SENTIMENTO_ENVIRONMENT=development

# Nível de log da aplicação (sobrescreve configs/logging.yaml quando definido)
SENTIMENTO_LOG_LEVEL=INFO

# URI de tracking do MLflow. Deixe em branco para usar o padrão local
# (mlruns/, definido em configs/config.yaml -> experiment.tracking_uri).
# Exemplo remoto: http://localhost:5000
SENTIMENTO_MLFLOW_TRACKING_URI=

# URL base do servidor Ollama local, usado pelos estágios de LLM que ainda
# não migraram ao cliente OpenAI-compatível abaixo (sobrescreve
# configs/llm.yaml).
SENTIMENTO_OLLAMA_BASE_URL=http://localhost:11434

# Token de acesso do Hugging Face Hub (necessário para modelos/datasets
# privados ou com licença restrita, ex.: alguns checkpoints do Llama).
# Gere em: https://huggingface.co/settings/tokens
SENTIMENTO_HUGGINGFACE_TOKEN=

# -----------------------------------------------------------------------------
# Credenciais do endpoint OpenAI-compatível (modelo UnB-Llama-3.3-70B-Instruct),
# usadas SEM o prefixo `SENTIMENTO_` (lidas diretamente via os.environ por
# src/hypothesaes/llm_api.py::create_client) pela re-rotulagem via LLM da
# etapa `labeling` (src/labeling/llm_relabeling.py) e pela etapa
# `hypothesaes_analysis` (interpretação/anotação de neurônios), quando
# `configs/llm.yaml -> active_provider: "openai"`. Com `active_provider:
# "ollama"`, nenhuma destas duas variáveis é necessária — o provedor usa o
# servidor Ollama local configurado em `configs/llm.yaml ->
# backends.ollama.base_url` em vez destas credenciais (não lê
# SENTIMENTO_OLLAMA_BASE_URL acima, que ainda não foi migrada a este fluxo).
# -----------------------------------------------------------------------------
OPENAI_BASE_URL=
OPENAI_KEY=

# -----------------------------------------------------------------------------
# Credenciais de contas do X/Twitter para coleta via twscrape (extra `collect`,
# ver `make install-collect`). O twscrape gerencia as contas em um banco
# SQLite local (accounts.db) via CLI, não via variáveis de ambiente — veja a
# documentação do pacote antes de rodar `make pipeline-ingestion`.
# https://github.com/vladkens/twscrape
# -----------------------------------------------------------------------------
