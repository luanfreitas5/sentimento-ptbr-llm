# =============================================================================
# .gitignore — projetos de ciência de dados (alinhado ao CLAUDE.md).
# Regra geral: dados e modelos são versionados por DVC/MLflow, não pelo Git.
# COMMITADOS de propósito: uv.lock, .env.example, .secrets.baseline,
# .vscode/settings.json, .vscode/launch.json, arquivos .dvc e .gitkeep.
# =============================================================================

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Ambientes / uv --------------------------------------------------------
.venv/
venv/
env/
# uv.lock DEVE ser commitado (reprodutibilidade) — não ignorar.

# --- Segredos / variáveis de ambiente --------------------------------------
.env
.env.*
!.env.example
# .secrets.baseline é commitado (usado pelo detect-secrets) — não ignorar.

# --- Dados (versionados por DVC) -------------------------------------------
data/bronze/*
data/silver/*
data/gold/*
# Mantém a estrutura de pastas e os ponteiros do DVC:
!data/**/.gitkeep
!data/**/*.dvc

# --- Modelos / experimentos ------------------------------------------------
models/*
!models/**/.gitkeep
!models/**/*.dvc
mlruns/
mlartifacts/
*.joblib
*.pkl
*.pt
*.onnx
*.h5

# --- DVC -------------------------------------------------------------------
/.dvc/cache
/.dvc/tmp
/.dvc/plots
/.dvc/config.local
# .dvc/config e os arquivos *.dvc são commitados.

# --- Logs ------------------------------------------------------------------
logs/
*.log

# --- Testes / cobertura / lint ---------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ruff_cache/
.mypy_cache/
.hypothesis/

# --- Documentação (build do MkDocs) ----------------------------------------
site/

# --- Notebooks -------------------------------------------------------------
.ipynb_checkpoints/

# --- Profiling -------------------------------------------------------------
*.speedscope
*.memray
profile.html
profile.json

# --- Sistema operacional ---------------------------------------------------
.DS_Store
Thumbs.db

# --- IDEs ------------------------------------------------------------------
.idea/
# Do VSCode, mantém apenas os arquivos de configuração compartilhados:
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json

# --- Arquivos do Claude ----------------------------------------------------
CLAUDE.md
CLAUDE.local.md
.claude/
.mcp.json

# --- Opcional: descomente para ignorar dados soltos por extensão -----------
# *.csv
# *.parquet
# *.xlsx
# *.feather

# --- Relatórios: versiona só agregados; ignora texto por tweet (LGPD) -------
reports/tables/**/corpus_diagnostico.parquet
reports/tables/**/casos_ambiguos.csv
reports/tables/**/conflitos_de_confianca.csv
reports/tables/**/exemplos_transicoes.csv
reports/tables/**/maiores_divergencias.csv
reports/tables/**/hipoteses_*_evidencias.csv
reports/tables/consenso_rotulagem/consenso_por_tweet.csv
reports/tables/consenso_rotulagem/tweets_em_disputa.csv
reports/tables/avaliacao/predicoes_teste.parquet
reports/tables/avaliacao/revisao_humana.csv
reports/tables/avaliacao/erros_maiores_por_paradigma.csv
reports/tables/diagnostics/
reports/tables/validacao_humana/para_rotular_500.csv
reports/tables/reconstrucao/erro_reconstrucao.parquet
reports/tables/reconstrucao/posts_mais_atipicos.csv
# interpretabilidade: só os resumos finais de hipóteses e validação
reports/interpretability/*
!reports/interpretability/diagnostics/
reports/interpretability/diagnostics/*
!reports/interpretability/diagnostics/resumo_hipoteses_*.txt
!reports/interpretability/diagnostics/resumo_validacao_*.txt
reports/interpretability/diagnostics/*_11_11.txt
# figuras: só avaliação, consenso e 2 comparativos representativos
reports/figures/reconstrucao/umap_espaco_latente.*
reports/figures/comparativo_*/
!reports/figures/comparativo_XLM-R_vs_GPT-6/
!reports/figures/comparativo_XLM-R_vs_UnB-Llama/
Monografia/
scripts/
